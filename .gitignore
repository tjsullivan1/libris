# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Environment files
.env

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# claude worktrees 
.claude/worktrees
# Node, for the extension test and lint tooling only. The extension itself
# ships no dependencies and needs no build step.
node_modules/

# Terraform. State holds secrets (infra/README.md); tfvars holds the Google client secret.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
# A saved plan (terraform plan -out) holds every variable, secrets included, in plain text.
*.tfplan
tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
# Not .terraform.lock.hcl: it pins the provider builds and is committed.
